# Supabase — public client values may be exposed to the browser; never add service keys to client code
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=server-only-service-key

# Monday.com — server-only; create a token from an Admin/Member account
MONDAY_API_TOKEN=your-monday-api-token
MONDAY_BOARD_ID=your-monday-board-id
MONDAY_GROUP_ID=optional-monday-group-id

# Obsidian Local REST API bridge — optional server-only integration
OBSIDIAN_API_URL=https://127.0.0.1:27124
OBSIDIAN_API_KEY=your-obsidian-local-rest-api-key

# Optional public deployment URL for external callbacks
NUXT_PUBLIC_SITE_URL=https://your-production-domain.example
